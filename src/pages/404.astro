---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you are looking for could not be found."
>
  <section class="py-20 md:py-32">
    <Container>
      <div class="text-center max-w-lg mx-auto">
        <div class="text-8xl font-heading font-bold text-brand-200 mb-6">404</div>
        <h1 class="font-heading text-3xl font-bold text-gray-900 mb-4">
          Page Not Found
        </h1>
        <p class="text-gray-600 leading-relaxed mb-8">
          The page you are looking for might have been moved or no longer exists. Let us help you find your way back.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <Button href="/" size="lg">
            Go Home
          </Button>
          <Button href="/products" variant="outline" size="lg">
            Browse Products
          </Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
