---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import { socialLinks } from '../data/social-links';

const faqs = [
  {
    question: 'Are your products Halal?',
    answer: 'Yes, all of our products are made with Halal-certified ingredients and processes. We are committed to meeting strict Halal standards in everything we create.',
  },
  {
    question: 'What ingredients do you use?',
    answer: 'We use only natural, organic ingredients such as shea butter, cocoa butter, organic beeswax, coconut oil, vitamin E, and pure essential oils. We never use parabens, preservatives, petroleum, synthetic fragrances, or artificial colors.',
  },
  {
    question: 'Do you ship nationwide?',
    answer: 'Yes, we ship throughout the United States. Shipping costs are calculated at checkout based on your location. All products are carefully packaged to ensure they arrive in perfect condition.',
  },
  {
    question: 'Are your products safe for sensitive skin?',
    answer: 'Our products are made with gentle, natural ingredients and are free from harsh chemicals. However, we always recommend testing on a small area first, especially if you have known allergies to specific ingredients.',
  },
  {
    question: 'How should I store the products?',
    answer: 'Store all products in a cool, dry place away from direct sunlight. Our lotion bars and balms are best kept at room temperature. In warmer months, they may soften slightly — this is normal and does not affect quality.',
  },
];
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with Herbal Shifa Co. for questions about our natural, Halal-certified skincare products. Based in Oklahoma."
>
  <section class="pt-8 pb-20 md:pt-12 md:pb-28">
    <Container>
      <Breadcrumbs items={[{ label: 'Contact' }]} />

      <div class="max-w-3xl mx-auto">
        <!-- Page Header -->
        <div class="text-center mb-16">
          <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
            Get in Touch
          </h1>
          <p class="text-lg text-gray-600 max-w-xl mx-auto">
            Have a question about our products or want to place an order? We would love to hear from you.
          </p>
        </div>

        <!-- Contact Info Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-16">
          <!-- Email -->
          <div class="p-6 rounded-2xl bg-gray-50 border border-gray-100 text-center">
            <div class="w-12 h-12 rounded-full bg-brand-100 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-700">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 mb-1">Email Us</h3>
            <a href="mailto:HerbalShifaCompany@gmail.com" class="text-brand-600 hover:text-brand-700 transition-colors">
              HerbalShifaCompany@gmail.com
            </a>
          </div>

          <!-- Location -->
          <div class="p-6 rounded-2xl bg-gray-50 border border-gray-100 text-center">
            <div class="w-12 h-12 rounded-full bg-brand-100 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-700">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 mb-1">Location</h3>
            <p class="text-gray-600">Oklahoma, United States</p>
          </div>
        </div>

        <!-- Social Media -->
        <div class="text-center mb-20">
          <h2 class="font-heading text-2xl font-bold text-gray-900 mb-2">Follow Us</h2>
          <p class="text-gray-600 mb-6">Stay connected and see our latest products.</p>
          <div class="flex justify-center gap-4">
            {socialLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="w-12 h-12 rounded-full bg-gray-100 hover:bg-brand-600 flex items-center justify-center text-gray-500 hover:text-white transition-all duration-200"
                aria-label={`Follow us on ${link.name}`}
              >
                <i class={link.iconClass} aria-hidden="true"></i>
              </a>
            ))}
          </div>
        </div>

        <!-- FAQ Section -->
        <div>
          <h2 class="font-heading text-2xl md:text-3xl font-bold text-gray-900 mb-8 text-center">
            Frequently Asked Questions
          </h2>

          <div class="space-y-4">
            {faqs.map((faq, index) => (
              <details class="group rounded-2xl bg-gray-50 border border-gray-100 overflow-hidden">
                <summary class="flex items-center justify-between cursor-pointer p-6 text-left font-medium text-gray-900 hover:text-brand-700 transition-colors list-none [&::-webkit-details-marker]:hidden">
                  <span>{faq.question}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 ml-4 text-gray-400 group-open:rotate-180 transition-transform duration-200">
                    <path d="m6 9 6 6 6-6"/>
                  </svg>
                </summary>
                <div class="px-6 pb-6 text-sm text-gray-600 leading-relaxed">
                  {faq.answer}
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
