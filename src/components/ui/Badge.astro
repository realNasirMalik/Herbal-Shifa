---
interface Props {
  variant?: 'default' | 'green' | 'blue';
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;

const variantClasses = {
  default: 'bg-gray-100 text-gray-700',
  green: 'bg-sage-100 text-sage-700',
  blue: 'bg-brand-50 text-brand-700',
};
---

<span class:list={['inline-flex items-center px-2.5 py-1 text-xs font-medium rounded-full', variantClasses[variant], className]}>
  <slot />
</span>
