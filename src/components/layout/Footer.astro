---
import { navigation } from '../../data/navigation';
import { socialLinks } from '../../data/social-links';
import Container from './Container.astro';
---

<footer class="bg-gray-950 text-gray-300" role="contentinfo">
  <Container>
    <div class="py-16 grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Brand -->
      <div class="md:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4">
          <div class="w-9 h-9 rounded-full bg-gradient-to-br from-brand-500 to-brand-400 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 20A7 7 0 0 1 9.8 6.9C15.5 4.9 17 3.5 17 3.5s1 2 2.5 3.5S22 9 22 9s-1.5 1.5-3.5 2.5S15.1 14.2 11 20z"/>
              <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
            </svg>
          </div>
          <span class="font-heading text-lg font-bold text-white">Herbal Shifa Co.</span>
        </a>
        <p class="text-sm text-gray-400 leading-relaxed max-w-xs">
          Your trusted partner in natural wellness. We craft high-quality, handmade herbal products to nourish your body and soul.
        </p>
        <p class="text-sm text-gray-500 mt-3">
          Handmade in Oklahoma
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Quick Links</h3>
        <ul class="space-y-3" role="list">
          {navigation.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-gray-400 hover:text-white transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Connect -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Connect With Us</h3>
        <div class="flex gap-3 mb-6">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full bg-gray-800 hover:bg-brand-600 flex items-center justify-center text-gray-400 hover:text-white transition-colors"
              aria-label={`Follow us on ${link.name}`}
            >
              <i class={link.iconClass} aria-hidden="true"></i>
            </a>
          ))}
        </div>
        <p class="text-sm text-gray-400">
          <a href="mailto:HerbalShifaCompany@gmail.com" class="hover:text-white transition-colors">
            HerbalShifaCompany@gmail.com
          </a>
        </p>
      </div>
    </div>

    <div class="border-t border-gray-800 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-gray-500">
        &copy; {new Date().getFullYear()} Herbal Shifa Co. All rights reserved.
      </p>
      <p class="text-xs text-gray-600">
        Natural &middot; Herbal &middot; Halal &middot; Handmade
      </p>
    </div>
  </Container>
</footer>
