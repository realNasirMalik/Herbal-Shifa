---
import Container from '../layout/Container.astro';
import Button from '../ui/Button.astro';
---

<section class="py-20 md:py-28 bg-white">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Image Placeholder -->
      <div class="aspect-[4/3] rounded-2xl bg-gradient-to-br from-brand-100 via-sage-100 to-brand-50 flex items-center justify-center overflow-hidden">
        <div class="text-center p-8">
          <div class="w-20 h-20 rounded-full bg-white/80 flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-brand-700">
              <path d="M11 20A7 7 0 0 1 9.8 6.9C15.5 4.9 17 3.5 17 3.5s1 2 2.5 3.5S22 9 22 9s-1.5 1.5-3.5 2.5S15.1 14.2 11 20z"/>
              <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
            </svg>
          </div>
          <p class="text-sm text-brand-700 font-medium">Founder Photo</p>
          <p class="text-xs text-gray-400 mt-1">Replace with actual image</p>
        </div>
      </div>

      <!-- Content -->
      <div>
        <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider mb-3">Our Story</p>
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-gray-900 mb-6">
          Crafted With Care, Rooted in Nature
        </h2>
        <p class="text-gray-600 leading-relaxed mb-4">
          Herbal Shifa Co. was born from a passion for natural wellness and a commitment to providing high-quality, handmade herbal products that you can trust. Every product is carefully formulated using organic ingredients — no harsh chemicals, no parabens, no artificial fragrances.
        </p>
        <p class="text-gray-600 leading-relaxed mb-8">
          Based in Oklahoma, we handcraft each product in small batches to ensure the highest quality. Our mission is simple: to help you embrace a healthier lifestyle through the power of herbal remedies and natural skincare.
        </p>

        <div class="flex flex-wrap gap-6 mb-8">
          <div>
            <p class="text-2xl font-bold text-brand-700">5+</p>
            <p class="text-sm text-gray-500">Products</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-brand-700">100%</p>
            <p class="text-sm text-gray-500">Natural</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-brand-700">0</p>
            <p class="text-sm text-gray-500">Chemicals</p>
          </div>
        </div>

        <Button href="/about" variant="secondary">
          Learn More About Us
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2">
            <path d="M5 12h14"/>
            <path d="m12 5 7 7-7 7"/>
          </svg>
        </Button>
      </div>
    </div>
  </Container>
</section>
