---
interface Props {
  ingredients: string[];
}

const { ingredients } = Astro.props;
---

<div class="space-y-2">
  {ingredients.map((ingredient) => (
    <div class="flex items-center gap-3 py-2 border-b border-gray-50 last:border-0">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-sage-500 shrink-0">
        <path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>
      </svg>
      <span class="text-sm text-gray-700">{ingredient}</span>
    </div>
  ))}
</div>
