---
import Container from '../layout/Container.astro';
import Button from '../ui/Button.astro';
---

<section class="relative overflow-hidden bg-gradient-to-br from-brand-900 via-brand-800 to-brand-950 text-white">
  <!-- Decorative background pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-10 left-10 w-64 h-64 rounded-full bg-brand-400 blur-3xl"></div>
    <div class="absolute bottom-10 right-10 w-96 h-96 rounded-full bg-sage-400 blur-3xl"></div>
  </div>

  <Container>
    <div class="relative py-20 md:py-32 lg:py-40 max-w-3xl">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-sm text-sm text-brand-200 mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M11 20A7 7 0 0 1 9.8 6.9C15.5 4.9 17 3.5 17 3.5s1 2 2.5 3.5S22 9 22 9s-1.5 1.5-3.5 2.5S15.1 14.2 11 20z"/>
          <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
        </svg>
        Halal &middot; Chemical-Free &middot; Handmade in Oklahoma
      </div>

      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
        Nourish Your Skin,
        <span class="text-brand-300">Naturally</span>
      </h1>

      <p class="text-lg md:text-xl text-brand-200 leading-relaxed mb-10 max-w-2xl">
        We craft high-quality, handmade herbal products to nourish your body and soul. From soothing therapeutic balms to rejuvenating skincare — experience the power of nature.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/products" class="inline-flex items-center justify-center font-medium rounded-lg transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500 px-8 py-4 text-base min-h-[52px] bg-white text-brand-900 hover:bg-gray-100 active:bg-gray-200 shadow-sm hover:shadow-md">
          Explore Our Products
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2">
            <path d="M5 12h14"/>
            <path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
        <a href="/about" class="inline-flex items-center justify-center font-medium rounded-lg transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500 px-8 py-4 text-base min-h-[52px] border-2 border-white/30 text-white hover:bg-white/10 active:bg-white/20">
          Our Story
        </a>
      </div>
    </div>
  </Container>
</section>
